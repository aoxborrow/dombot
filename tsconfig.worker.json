{
  // Type-checks the Cloudflare Worker host against the Workers runtime types
  // (worker-configuration.d.ts, generated by `npm run web:types`) instead of
  // the DOM lib the renderer uses. `npm run typecheck` runs both configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts"],
    "noEmit": true
  },
  "include": [
    "src/worker",
    "src/core",
    "src/shared",
    "worker-configuration.d.ts",
    "src/worker/env.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
