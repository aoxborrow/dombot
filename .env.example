# Registrar configuration — every provider's config options (PRODUCTION).
#
# Copy to .env and fill in only the registrars you use. This is the complete
# reference for the credentials each provider's constructor expects. For sandbox
# integration testing, use .env.testing instead (see .env.testing.example).
#
# Env var naming: <PROVIDER>_<FIELD>, where FIELD is the provider's config field
# upper-snake-cased (apiKey -> API_KEY, apiSecret -> API_SECRET, etc.).

# ============================================================================
# Sandbox-capable providers (here set to production; the library also defaults
# to production. Use .env.testing.example to target their sandboxes instead.)
# ============================================================================

# GoDaddy — get credentials at https://developer.godaddy.com
# For production, prefer a Personal Access Token (PAT): it enables the modern v3
# API (availability, registration, DNS, nameservers, list/get) and also works on
# the legacy v1/v2 endpoints used for renew, transfer, auto-renew, lock, privacy,
# contacts, and forwarding. The Key/Secret pair (sso-key) is v1/v2-only and is
# being deprecated by GoDaddy in 2026 — supply it only if you don't have a PAT.
# GODADDY_CUSTOMER_ID is only needed for domain forwarding, which uses GoDaddy's
# v2 customer-scoped API. Set it to your customer UUID, or to your numeric
# shopper/account ID (which the client resolves to the UUID — that lookup needs
# an sso-key, so supplying the UUID directly avoids the Key/Secret dependency).
GODADDY_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_CUSTOMER_ID=
GODADDY_ENVIRONMENT=production

# Namecheap — account username + API key.
# ClientIp is a required request parameter and must be one of your whitelisted
# IPv4 addresses (Namecheap allowlists API access by IP).
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_ENVIRONMENT=production

# Gandi — API key
GANDI_API_KEY=
GANDI_ENVIRONMENT=production

# NameSilo — API key
NAMESILO_API_KEY=
NAMESILO_ENVIRONMENT=production

# ============================================================================
# Production-only providers (no sandbox environment)
# ============================================================================

# Cloudflare — API token + Account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Dynadot — API key + secret for the RESTful v2 API (Tools > API; the secret
# signs requests and is never sent directly)
DYNADOT_API_KEY=
DYNADOT_API_SECRET=

# Spaceship — API key + secret from the API Manager
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Porkbun — API key + secret (enable API access per-domain)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# NameBright — OAuth2 client ID + secret
NAMEBRIGHT_CLIENT_ID=
NAMEBRIGHT_CLIENT_SECRET=
