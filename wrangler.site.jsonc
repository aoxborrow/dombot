// The marketing site at dombot.ai: a static-assets-only Worker serving the
// landing page build (npm run site:build → site/dist). No code, no bindings,
// no secrets.
//
// This is NOT the self-hosting config. `wrangler.jsonc` (the root) is what
// the Deploy button and `npm run web:deploy` use; this file is only ever read
// by .github/workflows/deploy-site.yml, which runs solely in the upstream
// repository, and by `npm run site:deploy` by hand.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dombot-site",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "dombot.ai", "custom_domain": true },
    { "pattern": "www.dombot.ai", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
